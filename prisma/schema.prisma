generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("viewer")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Merchant {
  id              String            @id @default(cuid())
  merchantId      String            @unique
  businessName    String
  contact         String
  email           String
  /// How goods move for this merchant:
  ///   "self-delivery" — merchant fulfils orders themselves using their own drivers / resources;
  ///                     we do NOT touch the stock or the delivery.
  ///   "drop-ship"     — supplier ships product to our warehouse on demand when an order is placed;
  ///                     we receive it and fulfil the order from that just-in-time delivery.
  ///   "consignment"   — supplier places stock in our warehouse but retains ownership until sale;
  ///                     we store it and fulfil orders as they come.
  deliveryType    String?           @default("self-delivery")
  /// Currency for all monetary values for this merchant (default UGX for Uganda)
  currency        String            @default("UGX")
  /// Onboarding fields
  taxId           String?
  address         String?
  bankName        String?
  bankAccount     String?
  contactPerson   String?
  altPhone        String?
  /// Payment terms: "net_7", "net_14", "net_30", "net_60", "prepaid", "cod"
  paymentTerms    String?
  /// JSON array of preferred communication channels: ["whatsapp", "email", "phone"]
  communicationChannels String?
  /// JSON array of delivery addresses (for self-delivery + drop-ship merchants):
  /// [{"label": "Main Warehouse", "address": "Plot 12, Kampala Rd", "type": "stock_delivery"}]
  deliveryAddresses String?
  /// JSON array of product category IDs this merchant supplies: ["Produce", "Dairy"]
  productCategories  String?
  contractStart   DateTime?
  contractEnd     DateTime?
  notes           String?
  /// Cumulative values for reporting
  totalInboundValue      Float      @default(0)
  totalSalesValue        Float      @default(0)
  totalShrinkageValue    Float      @default(0)
  totalReturnValue       Float      @default(0)
  expectedPayment        Float      @default(0)
  actualPayment          Float      @default(0)
  pendingPayment         Float      @default(0)
  /// Outstanding storage liability (accrued daily, settled on statement generation)
  storageLiabilityBalance Float     @default(0)
  /// Operational hold — when true, blocks new inbounds/orders for this merchant.
  /// Lightweight replacement for formal credit control. Set manually by supervisor
  /// when merchant has overdue statement balance or service dispute.
  isOnHold        Boolean           @default(false)
  holdReason      String?
  holdSetAt       DateTime?
  holdSetBy       String?
  isActive        Boolean           @default(true)
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Merchant communication log — calls, WhatsApp, emails, visits, meetings.
/// Fills the gap between system events (activity timeline) and human-to-human contact.
model MerchantCommunication {
  id              String    @id @default(cuid())
  merchantId      String
  /// Type of contact: call | whatsapp | email | visit | meeting | other
  type            String    @default("call")
  /// Direction: inbound | outbound
  direction       String    @default("outbound")
  subject         String
  notes           String?
  /// Who on our side made/received the contact
  recordedBy      String
  /// Optional follow-up date — surfaces in "follow-ups due" banner
  followUpAt      DateTime?
  isResolved      Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([merchantId])
  @@index([followUpAt])
  @@index([createdAt])
}

/// Driver communication log — calls/SMS with customers during delivery attempts.
/// Used to record "customer not at home", "customer refused delivery", "rescheduled", etc.
model DriverCommunication {
  id              String    @id @default(cuid())
  driverId        String
  driverName      String
  /// Type of contact: call | whatsapp | sms | visit | other
  type            String    @default("call")
  /// Direction: outbound (driver called customer) | inbound (customer called driver)
  direction       String    @default("outbound")
  subject         String
  notes           String?
  /// Optional link to the outbound order this communication relates to
  outboundId      String?
  orderNumber     String?
  customerName    String?
  customerContact String?
  /// Who recorded this (usually the driver themselves)
  recordedBy      String
  /// Optional follow-up date
  followUpAt      DateTime?
  isResolved      Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([driverId])
  @@index([outboundId])
  @@index([followUpAt])
  @@index([createdAt])
}

/// Per-merchant contracted rate card. One warehouse, many rate cards.
/// All amounts in the merchant's currency (UGX by default).
/// NOTE: no per-pallet storage fee — storage is charged per unit per day only.
model MerchantRateCard {
  id                    String   @id @default(cuid())
  merchantId            String   // references Merchant.merchantId
  // ── Receiving (ShipBob-style: flat first hours + hourly after) ──
  receivingFlatFee          Float @default(0)
  receivingFlatHours        Float @default(2)
  receivingHourlyAfter      Float @default(0)
  inboundReceivingPerUnit   Float @default(0)
  // ── Storage (ShipBob-style: bin/shelf/pallet monthly) ──
  storagePerBinMonth        Float @default(0)
  storagePerShelfMonth      Float @default(0)
  storagePerPalletMonth     Float @default(0)
  storagePerUnitPerDay      Float @default(0)
  // ── Pick & Pack (ShipBob-style: first items included + per additional) ──
  pickFirstItemsIncluded    Int   @default(4)
  pickPerAdditionalItem     Float @default(0)
  packPerOrder              Float @default(0)
  pickPerUnit               Float @default(0)
  // ── Fulfillment ──
  fulfillmentFeePerOrder    Float @default(0)
  fulfillmentMinimumFee     Float @default(0)
  // ── Returns ──
  returnProcessingPerUnit   Float @default(0)
  returnsPerOrder           Float @default(0)
  // ── Commission ──
  commissionPercent         Float @default(0)
  // ── COD-specific (Kwanza differentiator) ──
  codRemittanceFeePerOrder  Float @default(0)
  codShortfallPenalty       Float @default(0)
  // ── Metadata ──
  validFrom              DateTime  @default(now())
  validTo                DateTime?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([merchantId])
}

/// Storage liability — accrues daily per inbound unit until that unit is outbound or disposed.
/// One row per inbound batch (not per unit — keeps the table small).
/// Workflow 1: created on InboundRecord POST, updated by daily cron, settled on statement.
model StorageLiability {
  id                String    @id @default(cuid())
  merchantId        String
  merchantName      String
  inboundId         String
  productId         String
  productName       String
  unitsRemaining    Int       @default(0)
  ratePerUnitPerDay Float     @default(0)
  accrualStart      DateTime
  accrualThrough    DateTime?
  accruedAmount     Float     @default(0)
  settledAmount     Float     @default(0)
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([merchantId])
  @@index([inboundId])
}

/// Driver banking — daily deposit of COD cash collected.
/// Workflow 2: closes the loop between driver collecting cash and merchant being paid.
model DriverBanking {
  id              String    @id @default(cuid())
  bankingId       String    @unique
  driverId        String
  driverName      String
  amount          Float
  bankName        String?
  bankReference   String?
  slipPhotoUrl    String?
  runsheetId      String?
  status          String    @default("pending")
  verifiedBy      String?
  verifiedAt      DateTime?
  shortfallAmount Float     @default(0)
  notes           String?
  bankedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([driverId])
  @@index([runsheetId])
}

/// Monthly merchant statement — the primary deliverable to merchants.
/// Workflow 5: generated monthly, contains all line items, PDF + Excel versions.
model MerchantStatement {
  id                String    @id @default(cuid())
  statementId       String    @unique
  merchantId        String
  merchantName      String
  period            String
  openingBalance    Float     @default(0)
  inboundFees       Float     @default(0)
  storageFees       Float     @default(0)
  outboundFees      Float     @default(0)
  returnFees        Float     @default(0)
  shrinkageDebits   Float     @default(0)
  codCollected      Float     @default(0)
  codFees           Float     @default(0)
  commissions       Float     @default(0)
  salesValue        Float     @default(0)
  netPayable        Float     @default(0)
  isPaid            Boolean   @default(false)
  paidAt            DateTime?
  pdfUrl            String?
  excelUrl          String?
  /// Status: draft → pending_approval → approved → issued → paid
  status            String    @default("draft")
  /// Approval workflow (maker-checker)
  submittedBy       String?
  submittedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  /// Line items JSON for full audit (SQLite stores as TEXT)
  lineItems         String?
  generatedBy       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([merchantId])
  @@index([period])
  @@index([status])
}

/// Charge ledger — individual fee events that accrue before being rolled into a statement.
/// Replaces the "recompute everything at statement time" approach with a reviewable ledger.
/// Every fee event (inbound received, storage accrued, pick performed, shrinkage recorded)
/// writes a row here. Finance reviews and approves charges before they hit a statement.
model Charge {
  id              String    @id @default(cuid())
  chargeId        String    @unique
  merchantId      String
  merchantName    String
  /// Type: inbound_receiving | storage | pick | pack | return_processing | shrinkage | cod_fee | commission | ad_hoc
  chargeType      String
  amount          Float
  description     String
  /// Source: inbound | outbound | shrinkage | storage_liability | manual
  sourceType      String    @default("manual")
  sourceId        String?
  /// Period "YYYY-MM" for grouping into statements
  period          String
  /// Status: pending → approved → invoiced | rejected
  status          String    @default("pending")
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  /// Set when rolled into a statement
  statementId     String?
  recordedBy      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([merchantId])
  @@index([period])
  @@index([status])
  @@index([chargeType])
}

/// Statement dispute — merchant challenges a charge or line item on their statement.
/// Resolution can issue a credit memo (negative MerchantPayment) linked back here.
model StatementDispute {
  id                      String    @id @default(cuid())
  disputeId               String    @unique
  merchantId              String
  merchantName            String
  statementId             String
  /// Which line item is disputed (free text — matches line item reference)
  lineItemReference       String?
  /// Type: overcharge | missing_credit | wrong_rate | duplicate_charge | other
  disputeType             String    @default("overcharge")
  reason                  String
  /// Amount the merchant is claiming back
  creditAmountRequested   Float
  /// Amount finance approved (may differ from requested)
  creditAmountApproved    Float?
  /// Status: open → under_review → credited → rejected
  status                  String    @default("open")
  resolvedBy              String?
  resolvedAt              DateTime?
  resolutionNotes         String?
  /// Link to the credit memo MerchantPayment (negative amount) issued on resolution
  paymentId               String?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([merchantId])
  @@index([statementId])
  @@index([status])
}

/// Payment batch — groups multiple MerchantPayments into one payout run.
/// Workflow 6: finance team selects statements, generates batch, marks as disbursed.
model PaymentBatch {
  id              String    @id @default(cuid())
  batchId         String    @unique
  totalAmount     Float     @default(0)
  merchantCount   Int       @default(0)
  paymentMethod   String    @default("bank_transfer")
  bankReference   String?
  status          String    @default("draft")
  disbursedAt     DateTime?
  notes           String?
  recordedBy      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MerchantPayment {
  id            String    @id @default(cuid())
  paymentId     String    @unique
  merchantId    String
  merchantName  String
  vendorId      String
  amount        Float
  paymentMethod String
  reference     String
  comment       String?
  /// Allow for deductions such as warehouse fees
  deductions    Float     @default(0)
  netAmount     Float     @default(0) // amount - deductions
  recordedBy    String
  /// Link to the statement this payment settles (Workflow 6)
  statementId   String?
  /// Link to a payment batch (Workflow 6)
  batchId       String?
  /// Y/M/D fields for filtering
  year          Int       @default(0)
  month         Int       @default(0)
  day           Int       @default(0)
  /// Payment status (SQLite: free string)
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([merchantId])
  @@index([year, month])
  @@index([batchId])
}

model Product {
  id               String   @id @default(cuid())
  productId        String   @unique
  productLabel     String
  /// Editable product description for catalogs and invoices
  description      String?  @default("")
  /// Brand name (e.g., "Supreme", "Dettol")
  brand            String?
  /// Variant descriptor (e.g., "BLUE-50PCs", "500ml")
  variant          String?
  category         String
  merchantId       String
  merchantName     String
  unit             String
  /// Product weight (e.g., "50g", "175g", "500ml")
  weight           String?
  minStock         Int      @default(10)
  unitCost         Float
  unitSellingPrice Float
  commissionPercent Float
  currentStock     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Customer {
  id              String    @id @default(cuid())
  customerId      String    @unique
  name            String
  contact         String    @unique
  email           String?
  address         String?
  createdBy       String?
  totalOrders     Int       @default(0)
  totalOrderValue Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model InboundRecord {
  id              String    @id @default(cuid())
  inboundId       String    @unique
  /// Vendor/supplier code (e.g., V001)
  vendorId        String?
  merchantId      String
  merchantName    String
  productName     String
  productId       String
  /// Brand name for display
  brand           String?
  /// Variant descriptor (color, size, weight)
  variant         String?
  qtyIn           Int
  /// Per-unit cost price
  unitPrice       Float?
  /// Total inbound value (qtyIn x unitPrice)
  inboundValue    Float?
  expiryDate      DateTime?
  receivedBy      String
  /// Who physically placed the item in storage
  storedBy        String?
  /// Zone-Level-Pallet format (e.g., B-L3-P3)
  storageLocation String?
  status          String    @default("received")
  userComment     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OutboundRecord {
  id                String    @id @default(cuid())
  outboundId        String    @unique
  /// Explicit order number (e.g., ORD-20260414-001, DS-014, RT-001)
  orderNumber       String?
  /// Preserves the original DS-XXX order number when an RMA flips it to RT-XXX.
  originalOrderNumber String?
  /// User who created this order (e.g., U003, U004)
  userId            String?
  /// Tracking number for shipment tracking
  trackingNumber    String?
  /// Vendor/supplier code (e.g., V001)
  vendorId          String?
  /// Vendor business name
  businessName      String?
  customerName      String
  customerContact   String
  customerEmail     String?
  customerAddress   String?
  productName       String
  productId         String
  brand             String?
  variant           String?
  qty               Int
  /// Per-unit selling price
  unitSellingPrice  Float?
  /// Total sale amount for this order (qty x unitSellingPrice)
  saleAmount        Float?
  /// Who assigned this order/driver
  assignedBy        String?
  assignedDriver    String?
  vehicleNumber     String?
  /// Group ID for runsheet — outbound records sharing the same runsheetId belong to one rider trip
  runsheetId        String?
  /// Stop sequence within the runsheet (1, 2, 3...)
  stopSequence      Int?
  /// Actual quantity delivered (may differ from qty if partial delivery)
  actualDeliveredQty Int?
  /// Cash on Delivery amount collected at this stop
  codCollected      Float?
  /// Reason if delivery failed, rejected, or partially returned
  deliveryNotes     String?
  status            String    @default("pending")
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  /// Cancellation fields
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledBy         String?
  /// Delivery attempt tracking (max retries before permanent failure)
  deliveryAttempts    Int       @default(0)
  maxAttempts         Int       @default(5)
  /// Reschedule fields
  nextAttemptDate     DateTime?
  lastAttemptReason   String?
  lastAttemptDate     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ReconciliationRecord {
  id              String    @id @default(cuid())
  type            String
  referenceId     String?
  expectedQty     Float
  actualQty       Float
  variance        Float
  varianceReason  String?
  reconciledBy    String
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

model RTVRecord {
  id              String    @id @default(cuid())
  rtvId           String    @unique
  merchantId      String
  merchantName    String
  productId       String
  productName     String
  qty             Int
  reason          String
  status          String    @default("pending")
  processedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ShrinkageRecord {
  id              String    @id @default(cuid())
  shrinkageId     String    @unique
  /// Link to RTV if shrinkage is related to return
  rtvId           String?
  /// Merchant who owns the lost stock (for debit)
  merchantId      String?
  merchantName    String?
  productId       String
  productName     String
  qty             Int
  /// Per-unit cost (UGX) — used to compute debit amount
  unitCost        Float?
  /// Total value of shrinkage (UGX) = qty × unitCost
  totalValue      Float?
  reason          String
  reportedBy      String
  status          String    @default("pending")
  /// Workflow 4: if true, the totalValue is debited to the merchant on resolution
  debitMerchant   Boolean   @default(false)
  /// Statement ID this shrinkage was debited on (set when settled)
  settledOnStatementId String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([merchantId])
  @@index([rtvId])
}

model Driver {
  id                String    @id @default(cuid())
  driverId          String    @unique
  name              String
  phone             String    @unique
  nationalId        String?
  licenseNumber     String?
  vehicleType       String?
  vehicleNumber     String?
  createdBy         String?
  profileImage      String?
  dateHired         DateTime?
  salaryAmount      Float?
  salaryPayDay      Int       @default(28)
  status            String    @default("active")
  damages           Float     @default(0)
  loss              Float     @default(0)
  expectedBankings  Float     @default(0)
  banked            Float     @default(0)
  /// Shift tracking: when the driver checked in (null = off shift)
  shiftStart        DateTime?
  /// Shift tracking: when the driver checked out (null = still on shift)
  shiftEnd          DateTime?
  trips             DriverTrip[]
  shifts            DriverShift[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Shift history — one row per completed shift. Created when a driver
/// checks out. Enables hours-worked calculations for payroll.
model DriverShift {
  id              String    @id @default(cuid())
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [driverId])
  driverName      String
  shiftStart      DateTime
  shiftEnd        DateTime?
  durationHours   Float?
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([driverId])
  @@index([shiftStart])
}

/// Daily trip record for each driver — the 'route sheet'
model DriverTrip {
  id              String    @id @default(cuid())
  tripId          String    @unique
  driverId        String
  driver          Driver    @relation(fields: [driverId], references: [driverId])
  driverName      String
  /// Trip date (not createdAt — the actual day of the trip)
  tripDate        DateTime
  /// Total stops/deliveries assigned
  totalStops      Int       @default(0)
  /// Successfully delivered
  delivered        Int       @default(0)
  /// Failed deliveries
  failed          Int       @default(0)
  /// Total COD collected
  codCollected    Float     @default(0)
  /// Total sale value
  saleAmount      Float     @default(0)
  /// Kilometres driven
  distanceKm      Float?
  /// GPS tracking enabled?
  geoTracked      Boolean   @default(false)
  /// Last known GPS coordinates (JSON string)
  lastGeoLocation String?
  /// Runsheet reference
  runsheetId      String?
  /// Notes / issues
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([driverId, tripDate])
}

/// Each physical unit tracked individually — the 'library book'
model InventoryItem {
  id                String    @id @default(cuid())
  /// Unique item barcode/ID shown on labels
  itemId            String    @unique
  productId         String
  productName       String
  /// Brand name
  brand             String?
  /// Variant descriptor
  variant           String?
  /// Per-unit cost
  unitPrice         Float?
  merchantId        String
  merchantName      String
  /// Which inbound batch this item came from
  inboundId         String?
  /// Which outbound order this item is allocated to (null = in warehouse)
  outboundId        String?
  /// Current lifecycle status
  status            String    @default("IN_WAREHOUSE")
  /// Item condition: good, damaged, expired
  condition         String    @default("good")
  /// Tracking level: 'unit' for individual items, 'box' for sealed boxes
  trackingLevel     String    @default("unit")
  /// For boxes: how many units inside
  boxQty            Int?
  /// For individual items: which box they came from
  parentItemId      String?
  /// Warehouse zone / shelf location
  storageLocation   String?
  /// Expiry date if applicable
  expiryDate        DateTime?
  /// Which rider is currently handling this item
  assignedRider     String?
  /// Which runsheet this item is on
  runsheetId        String?
  /// Delivery attempt count for this item
  attemptCount      Int       @default(0)
  nextAttemptDate   DateTime?
  /// Final outcome when lifecycle ends
  finalOutcome      String?
  /// Cancellation tracking
  cancellationReason String?
  cancelledAt       DateTime?
  cancelledBy       String?
  /// Audit trail — every event in this item's lifecycle
  events            ItemEvent[]
  /// Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// Every event in an item's lifecycle — the 'checkout card inside the front cover'
model ItemEvent {
  id                String    @id @default(cuid())
  eventId           String    @unique
  /// Which item this event belongs to
  item              InventoryItem @relation(fields: [itemId], references: [itemId])
  itemId            String
  /// Event type: RECEIVED, STORED, PICKED, PACKED, DISPATCHED,
  ///   DELIVERY_ATTEMPTED, DELIVERY_SUCCEEDED, DELIVERY_FAILED,
  ///   RESCHEDULED, PARTIALLY_RETURNED, RETURNED_TO_RIDER,
  ///   RETURNED_TO_WAREHOUSE, CANCELLED, DAMAGED, DISPOSED, RTV
  eventType         String
  /// Workflow 3: disposition decided for returned units
  /// RESTOCK | RTV | DISPOSE | LIQUIDATE — null for non-return events
  disposition       String?
  /// Human-readable description
  description       String?
  /// Who performed this action
  performedBy       String?
  /// Which runsheet (if applicable)
  runsheetId        String?
  /// Which outbound order (if applicable)
  outboundId        String?
  /// Which inbound batch (if applicable)
  inboundId         String?
  /// Reason for failure / return / cancellation
  reason            String?
  /// Previous status before this event
  previousStatus    String?
  /// New status after this event
  newStatus         String?
  /// Additional metadata as JSON string
  metadata          String?
  createdAt         DateTime  @default(now())

  @@index([itemId])
}

/// After-Sales module — customer returns (RMA).
/// Workflow 3: handles customers returning items. Agent approves/rejects,
/// order number flips from DS to RT, per-item disposition applied on approval.
model AfterSalesRecord {
  id              String    @id @default(cuid())
  afterSalesId    String    @unique
  /// Reference to original outbound order
  originalOrderId String?
  /// New order number for return process (RT- prefix)
  returnOrderNumber String?
  /// Customer who initiated return
  customerId      String
  customerName    String
  /// Return reason
  reason          String
  /// Return status: initiated | in_review | approved | rejected | processed
  returnStatus    String    @default("initiated")
  /// Agent handling the return
  agentId         String?
  agentName       String?
  /// Approval details
  approvedBy      String?
  approvedAt      DateTime?
  /// Refund amount (UGX)
  refundAmount    Float?
  /// Replacement product (if applicable)
  replacementProductId String?
  replacementProductName String?
  /// Tracking number for return shipment
  returnTrackingNumber String?
  /// Workflow 3: list of itemIds being returned (JSON array, stored as TEXT in SQLite)
  itemIds         String?
  /// Workflow 3: per-item disposition decision (JSON: [{itemId, disposition}])
  dispositions    String?
  /// Resolution notes
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Order Processing Module — entry point for the order → outbound cascade.
/// Workflow 2: creating an OrderProcessing row spawns an OutboundRecord automatically.
model OrderProcessing {
  id                String    @id @default(cuid())
  orderId           String    @unique
  orderNumber       String    @unique  // e.g., DS001
  orderDate         DateTime  @default(now())
  customerId        String
  customerName      String
  customerInfo      String    // Full customer contact details
  totalAmount       Float
  paymentMethod     String    // Cash, M-Pesa, Bank Transfer, etc.
  /// Status of order processing: new_order | processing | shipped | delivered | returned
  status            String    @default("new_order")
  /// Tracking number for the order (auto-generated from orderNumber + deliveryType)
  trackingNumber    String?
  /// Invoice details
  invoiceGenerated  Boolean   @default(false)
  invoiceNumber     String?
  invoiceDate       DateTime?
  /// Created by user
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id              String    @id @default(cuid())
  userId          String?
  userName        String?
  action          String
  module          String
  entityId        String?
  details         String?
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@index([module])
  @@index([action])
  @@index([userId])
}

/// Notification queue — SMS/email messages to be sent to customers and merchants.
model Notification {
  id              String    @id @default(cuid())
  type            String
  recipient       String
  recipientName   String?
  subject         String
  message         String
  metadata        String?
  status          String    @default("pending")
  sentAt          DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([type])
}

/// Product price history — tracks every price change for audit trail.
model ProductPriceHistory {
  id              String    @id @default(cuid())
  productId       String
  productName     String
  oldPrice        Float
  newPrice        Float
  oldCost         Float?
  newCost         Float?
  changedBy       String
  changedAt       DateTime  @default(now())

  @@index([productId])
  @@index([changedAt])
}

/// Order line items — supports multi-product orders.
model OrderLineItem {
  id              String    @id @default(cuid())
  orderId         String
  orderNumber     String
  productId       String
  productName     String
  brand           String?
  variant         String?
  qty             Int
  unitSellingPrice Float
  lineTotal       Float
  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([orderNumber])
  @@index([productId])
}
// ── RISK MODULE ───────────────────────────────────────────────────────────────
// Fraud detection & order risk scoring. Standalone subsystem — other modules
// (Outbound, Order Processing, After-Sales) subscribe to it via /api/risk/*.

/// Manual blocklist — phones and addresses that should never pass intake.
model FraudBlocklist {
  id        String   @id @default(cuid())
  phone     String?  @unique
  address   String?
  reason    String
  addedBy   String
  addedAt   DateTime @default(now())
  isActive  Boolean  @default(true)

  @@index([address])
  @@index([isActive])
}

/// Persisted score for every order that enters the system.
model RiskScore {
  id               String   @id @default(cuid())
  outboundId       String
  customerContact  String
  customerAddress  String?
  score            Int
  decision         String
  reasons          String
  engineVersion    String   @default("1.0.0")
  paymentPath      String
  scoredAt         DateTime @default(now())

  @@index([outboundId])
  @@index([customerContact])
  @@index([decision])
  @@index([scoredAt])
}

/// Manager override on a held order. Append-only.
model RiskOverride {
  id           String   @id @default(cuid())
  outboundId   String
  action       String
  managerName  String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([outboundId])
  @@index([createdAt])
}

/// Cached risk profile per customer (keyed by phone).
model CustomerRiskProfile {
  customerContact       String   @id
  customerType          String   @default("retail")
  totalOrders           Int      @default(0)
  codRefusals90d        Int      @default(0)
  codDelivered90d       Int      @default(0)
  distinctAddressesUsed Int      @default(0)
  firstOrderDate        DateTime?
  lastOrderDate         DateTime?
  avgAOV                Float    @default(0)
  isBlocklisted         Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

/// Key-value store for all risk engine parameters.
model RiskSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String
  label     String
  inputType String
  helpText  String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// System-wide settings — categories, units, payment methods, storage locations.
/// Key-value store where each row is one setting type (value is JSON-serialized array).
/// Seeded on first GET if empty.
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON-serialized array of strings
  label     String
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Default rate card — the 3PL operator's standard pricing.
/// Applied automatically when onboarding a new merchant.
/// Stored as a single row (key = 'default').
model DefaultRateCard {
  id                        String  @id @default(cuid())
  // Receiving
  receivingFlatFee          Float   @default(0)
  receivingFlatHours        Float   @default(2)
  receivingHourlyAfter      Float   @default(0)
  inboundReceivingPerUnit   Float   @default(0)
  // Storage
  storagePerBinMonth        Float   @default(0)
  storagePerShelfMonth      Float   @default(0)
  storagePerPalletMonth     Float   @default(0)
  storagePerUnitPerDay      Float   @default(0)
  // Pick & Pack
  pickFirstItemsIncluded    Int     @default(4)
  pickPerAdditionalItem     Float   @default(0)
  packPerOrder              Float   @default(0)
  pickPerUnit               Float   @default(0)
  // Fulfillment
  fulfillmentFeePerOrder    Float   @default(0)
  fulfillmentMinimumFee     Float   @default(0)
  // Returns
  returnProcessingPerUnit   Float   @default(0)
  returnsPerOrder           Float   @default(0)
  // Commission
  commissionPercent         Float   @default(0)
  // COD
  codRemittanceFeePerOrder  Float   @default(0)
  codShortfallPenalty       Float   @default(0)
  // Meta
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Rate card templates — named pricing tiers the 3PL can create and apply.
/// E.g., "Standard", "Premium", "Consignment", "Bulk Discount".
model RateCardTemplate {
  id                        String  @id @default(cuid())
  name                      String
  description               String?
  // Receiving
  receivingFlatFee          Float   @default(0)
  receivingFlatHours        Float   @default(2)
  receivingHourlyAfter      Float   @default(0)
  inboundReceivingPerUnit   Float   @default(0)
  // Storage
  storagePerBinMonth        Float   @default(0)
  storagePerShelfMonth      Float   @default(0)
  storagePerPalletMonth     Float   @default(0)
  storagePerUnitPerDay      Float   @default(0)
  // Pick & Pack
  pickFirstItemsIncluded    Int     @default(4)
  pickPerAdditionalItem     Float   @default(0)
  packPerOrder              Float   @default(0)
  pickPerUnit               Float   @default(0)
  // Fulfillment
  fulfillmentFeePerOrder    Float   @default(0)
  fulfillmentMinimumFee     Float   @default(0)
  // Returns
  returnProcessingPerUnit   Float   @default(0)
  returnsPerOrder           Float   @default(0)
  // Commission
  commissionPercent         Float   @default(0)
  // COD
  codRemittanceFeePerOrder  Float   @default(0)
  codShortfallPenalty       Float   @default(0)
  // Meta
  isActive                  Boolean @default(true)
  createdBy                 String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}
